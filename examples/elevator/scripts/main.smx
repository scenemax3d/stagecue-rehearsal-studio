UI.Load "story"
var shot = 1
network.on ("picture_meeting", msg) = do
 shot = 1
 UI.story.stage.picture.image = "sprites/meeting.jpg"
 Logger.info "PICTURE_MEETING"
end do
network.on ("picture_lift", msg) = do
 shot = 2
 UI.story.stage.picture.image = "sprites/lift.jpg"
 Logger.info "PICTURE_LIFT"
end do
network.on ("picture_cabin", msg) = do
 shot = 3
 UI.story.stage.picture.image = "sprites/cabin.jpg"
 Logger.info "PICTURE_CABIN"
end do
network.on ("picture_evidence", msg) = do
 shot = 4
 UI.story.stage.picture.image = "sprites/evidence.jpg"
 Logger.info "PICTURE_EVIDENCE"
end do
network.on ("picture_clue", msg) = do
 shot = 5
 UI.story.stage.picture.image = "sprites/clue.jpg"
 Logger.info "PICTURE_CLUE"
end do
network.on ("picture_iris", msg) = do
 shot = 6
 UI.story.stage.picture.image = "sprites/iris.jpg"
 Logger.info "PICTURE_IRIS"
end do
network.on ("picture_ray", msg) = do
 shot = 7
 UI.story.stage.picture.image = "sprites/rayapproach.jpg"
 Logger.info "PICTURE_RAY"
 wait 0.35 seconds
 if (shot == 7) {
  UI.story.stage.picture.image = "sprites/ray.jpg"
 }
end do
var shaking = 0
network.on ("elevator_shake", msg) = do
 if (shaking == 0) {
  shaking = 1
  Logger.info "ELEVATOR_SHAKE_START"
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleright.jpg"
  }
  cabin.move (x+0.20) in 0.1 seconds
  Logger.info cabin.x
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleleft.jpg"
  }
  cabin.move (x-0.41) in 0.13 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleright.jpg"
  }
  cabin.move (x+0.37) in 0.12 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleleft.jpg"
  }
  cabin.move (x-0.34) in 0.12 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleright.jpg"
  }
  cabin.move (x+0.40) in 0.13 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleleft.jpg"
  }
  cabin.move (x-0.42) in 0.13 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleright.jpg"
  }
  cabin.move (x+0.35) in 0.12 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleleft.jpg"
  }
  cabin.move (x-0.26) in 0.13 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleright.jpg"
  }
  cabin.move (x+0.18) in 0.12 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/rattleleft.jpg"
  }
  cabin.move (x-0.07) in 0.14 seconds
  if (shot == 2) {
   UI.story.stage.picture.image = "sprites/lift.jpg"
  }
  cabin.pos(0,0,0)
  Logger.info "ELEVATOR_SHAKE_END"
  shaking = 0
 }
end do
wait for network.ready == 1
Logger.info "ELEVATOR_READY"
