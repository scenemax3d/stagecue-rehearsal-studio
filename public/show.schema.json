{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "showId": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "default": "he-IL",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "default": "1.0",
      "type": "string",
      "minLength": 1
    },
    "startStateId": {
      "type": "string",
      "minLength": 1
    },
    "recognition": {
      "type": "object",
      "properties": {
        "provider": {
          "default": "local-hebrew-asr",
          "type": "string",
          "enum": [
            "mock",
            "browser",
            "local-hebrew-asr"
          ]
        },
        "windowSize": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "maxHistoryAgeMs": {
          "default": 30000,
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "currentLineWeight": {
          "default": 0.7,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "historyWeight": {
          "default": 0.3,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matchThreshold": {
          "default": 0.82,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minCurrentLineScore": {
          "default": 0.65,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requireTerminalEvidence": {
          "default": true,
          "type": "boolean"
        },
        "endpointSilenceMs": {
          "default": 400,
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        },
        "vadThreshold": {
          "default": 0.012,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gateMicDuringPlayback": {
          "default": true,
          "type": "boolean"
        },
        "cooldownMs": {
          "default": 220,
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "sceneMax": {
      "type": "object",
      "properties": {
        "gateway": {
          "type": "string",
          "pattern": "^wss?:\\/\\/"
        },
        "projectGuid": {
          "type": "string"
        },
        "sessionId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "scene": {
          "type": "string"
        }
      },
      "required": [
        "gateway",
        "projectGuid",
        "sessionId",
        "scene"
      ]
    },
    "scenePackage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "audio",
              "video",
              "image"
            ]
          },
          "uri": {
            "type": "string",
            "pattern": "^assets\\/(?!.*\\.\\.)(?!.*[\\\\:]).+$"
          }
        },
        "required": [
          "id",
          "type",
          "uri"
        ]
      }
    },
    "states": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "human_line",
              "virtual_line"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "expectedText": {
            "type": "string"
          },
          "scriptedTurn": {
            "type": "boolean"
          },
          "alternatives": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "trigger": {
            "default": {
              "mode": "composite",
              "requireCurrentLine": true
            },
            "type": "object",
            "properties": {
              "mode": {
                "default": "composite",
                "type": "string",
                "const": "composite"
              },
              "threshold": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minCurrentLineScore": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "requireTerminalEvidence": {
                "type": "boolean"
              },
              "requireCurrentLine": {
                "default": true,
                "type": "boolean"
              }
            }
          },
          "sceneEntryEvent": {
            "type": "string"
          },
          "actionMode": {
            "type": "string",
            "enum": [
              "sequential",
              "parallel"
            ]
          },
          "actions": {
            "default": [],
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "youtube"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "url"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "scenemax"
                    },
                    "event": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "event",
                    "message"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "play_audio"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "volume": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "delayMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3600000
                    }
                  },
                  "required": [
                    "type",
                    "assetId"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "play_video"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "delayMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3600000
                    }
                  },
                  "required": [
                    "type",
                    "assetId"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "show_image"
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "durationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3600000
                    }
                  },
                  "required": [
                    "type",
                    "assetId"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "text_to_speech"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "voice": {
                      "type": "string",
                      "enum": [
                        "noa",
                        "omer",
                        "asaf"
                      ]
                    },
                    "speed": {
                      "type": "number",
                      "minimum": 0.75,
                      "maximum": 1.5
                    },
                    "pitch": {
                      "type": "number",
                      "minimum": -6,
                      "maximum": 6
                    },
                    "assetId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "text",
                    "voice",
                    "assetId"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "wait"
                    },
                    "durationMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3600000
                    }
                  },
                  "required": [
                    "type",
                    "durationMs"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "emit_ws"
                    },
                    "event": {
                      "type": "string",
                      "minLength": 1
                    },
                    "payload": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "event"
                  ]
                }
              ]
            }
          },
          "nextStateId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "actor",
          "expectedText",
          "nextStateId"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "showId",
    "title",
    "startStateId",
    "recognition",
    "assets",
    "states"
  ]
}
